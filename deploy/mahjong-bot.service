[Unit]
Description=Riichi Mahjong Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Oracle "Canonical Ubuntu" 이미지의 기본 유저는 ubuntu,
# "Oracle Linux" 이미지는 opc 입니다. 사용하는 이미지에 맞게 바꾸세요.
User=ubuntu
WorkingDirectory=/opt/mahjong-bot
ExecStart=/opt/mahjong-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
# 토큰은 WorkingDirectory 안의 .env 를 bot.py 가 자동으로 읽습니다.
# systemd 환경파일로 주고 싶으면 아래 주석을 해제하세요(형식 동일: KEY=VALUE):
#EnvironmentFile=/opt/mahjong-bot/.env

[Install]
WantedBy=multi-user.target
